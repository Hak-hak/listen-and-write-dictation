{
  "entities": {
    "StudyItem": {
      "title": "StudyItem",
      "description": "A single listening and spelling sentence item.",
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "description": "English sentence to listen and spell.",
          "minLength": 1,
          "maxLength": 240
        },
        "vi": {
          "type": "string",
          "description": "Vietnamese translation hint.",
          "minLength": 1,
          "maxLength": 240
        },
        "emoji": {
          "type": "string",
          "description": "Optional emoji cue.",
          "minLength": 0,
          "maxLength": 16
        }
      },
      "required": ["en", "vi", "emoji"]
    },
    "StudySet": {
      "title": "StudySet",
      "description": "A user-created collection of English listening and spelling practice sentences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier matching the Firestore document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Title of the study set.",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Short description of the study set.",
          "minLength": 0,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "description": "Topic category for the study set.",
          "enum": ["Giao tiếp", "Ngữ pháp", "IELTS & Học thuật", "Từ vựng", "Khác"],
          "maxLength": 60
        },
        "visibility": {
          "type": "string",
          "description": "Sharing visibility of the study set.",
          "enum": ["public", "unlisted", "private"]
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the creator (non-PII).",
          "minLength": 1,
          "maxLength": 80
        },
        "items": {
          "type": "array",
          "description": "Bounded array of 1 to 50 StudyItem objects."
        },
        "itemCount": {
          "type": "integer",
          "description": "Total number of sentences in items (1 to 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the study set was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the study set was last updated."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "category",
        "visibility",
        "ownerId",
        "ownerName",
        "items",
        "itemCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/studySets/{setId}": {
      "schema": { "$ref": "#/entities/StudySet" },
      "description": "Stores user-created listening and spelling practice sets that can be shared via link."
    }
  }
}
